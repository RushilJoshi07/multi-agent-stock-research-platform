# Copy to .env and fill in. Every value here is a placeholder or a safe local default.
# Never commit .env.

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
MARKET_TIMEZONE=America/New_York          # arq cron schedules (Phase 4)

# ---- Postgres (Docker Compose) ----
POSTGRES_USER=fathom
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=fathom
POSTGRES_HOST_PORT=5433                   # old project uses 5432
DATABASE_URL=postgresql://fathom:change-me-local@localhost:5433/fathom
DATABASE_URL_TEST=postgresql://fathom:change-me-local@localhost:5433/fathom_test

# ---- Redis / arq ----
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---- API / web ----
API_HOST_PORT=8001                        # old project uses 8000
WEB_HOST_PORT=5174                        # old project uses 5173
CORS_ORIGINS=http://localhost:5174

# ---- AWS / Bedrock (Claude) — used from Phase 3 ----
AWS_PROFILE=bedrock                       # profile in ~/.aws, same as the old project
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6   # old project's verified ID; model choice is a Phase 3 decision
AWS_ACCESS_KEY_ID=                        # leave blank locally (the profile is used); prod uses an IAM role (Phase 6)
AWS_SECRET_ACCESS_KEY=

# ---- LangSmith ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fathom-dev

# ---- Alpaca (paper only) ----
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true                         # code refuses to start if this is not true
ALPACA_DATA_FEED=iex                      # free tier feed

# ---- Finnhub ----
FINNHUB_API_KEY=

# ---- SEC EDGAR (no key; a User-Agent with a contact email is required) ----
SEC_EDGAR_USER_AGENT="Fathom your-email@example.com"

# ---- Access control and cost (Phases 3–4; placeholders until measured) ----
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD_HASH=
SESSION_SECRET_KEY=
RATE_LIMIT_PER_MINUTE=30
RUN_COST_BUDGET_USD=0.50
DAILY_AI_COST_CAP_USD=1.00

# ---- Monitoring (Phase 6) ----
SENTRY_DSN=

# ---- Optional, after v1 only ----
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
