{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "plansDirectory": "plans",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(make up)",
      "Bash(make test)",
      "Bash(make test-web)",
      "Bash(make lint)",
      "Bash(make gate *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(//Users/rushil/agentic-finance-platform/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-log-note.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
